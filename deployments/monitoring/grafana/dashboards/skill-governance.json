      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(niceagent_skill_rate_limit_denials_total[5m]))",
          "legendFormat": "skill rate-limit",
