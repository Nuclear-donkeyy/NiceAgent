      "title": "Governance denial comparison",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Runtime tool call pressure by skill id. Spikes here followed by rate-limit denials usually mean the model is repeatedly choosing the same external skill.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
